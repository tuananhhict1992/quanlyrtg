VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server only: Supabase Secret key for Admin creating/resetting accounts. NEVER use VITE_ prefix.
SUPABASE_SECRET_KEY=
# Server only. Obtain a TLS-enabled connection string from your Supabase project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=supabase%2Fcerts%2Fprod-ca-2021.txt
# Set to 1 behind the AI Studio/Cloud Run ingress; keep 0 without a trusted proxy.
TRUST_PROXY_HOPS=0
# Choose ONE Google authentication method. Current RTG deployment uses admin OAuth.
# OAuth for an admin's My Drive. Keep these secrets server-side.
PUBLIC_APP_URL=https://YOUR_APP.run.app
# Additional exact HTTPS origins serving the same RTG app, comma-separated; no wildcards.
GOOGLE_OAUTH_ALLOWED_ORIGINS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# OAuth callback: PUBLIC_APP_URL/api/google/oauth/callback
# Refresh tokens are encrypted in private.google_connections; never put them in VITE_*.
# OAuth reads Drive/Spreadsheet IDs from private.google_connections, not the values below.
# Alternative ONLY: service account for an organization's Shared Drive.
# Leave GOOGLE_CLIENT_EMAIL and GOOGLE_PRIVATE_KEY unset when using OAuth.
GOOGLE_CLIENT_EMAIL=
# Shared Drive folder named RTG_SYSTEM, accessible by this service account.
GOOGLE_DRIVE_ROOT_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
RUN_SYNC_WORKER=false
GEMINI_API_KEY=
PORT=3000
